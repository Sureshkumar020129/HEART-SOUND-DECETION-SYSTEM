# ============================================================
# AI-Powered Heart Sound Disease Detection System
# Environment Variables — COPY to .env and fill in values
# NEVER commit .env to source control
# ============================================================

# Django
SECRET_KEY=your-very-secret-django-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite default — no changes needed for development)
# DB_NAME=db.sqlite3

# Media / File Storage
MEDIA_ROOT=media
MAX_AUDIO_UPLOAD_MB=50

# AI Chatbot Provider (choose one or leave blank for rule-based fallback)
# Supported: openai | gemini | anthropic | (blank for fallback)
AI_PROVIDER=
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AI Model names (defaults shown)
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ML Model Configuration
ML_MODEL_PATH=ml_models/heart_sound_classifier.pkl
ML_SCALER_PATH=ml_models/scaler.pkl
ML_MODEL_VERSION=1.0.0

# Email (for password reset — optional for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Rate Limiting
ANALYSIS_RATE_LIMIT=10/hour
CHATBOT_RATE_LIMIT=30/hour
